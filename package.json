{
  "name": "@javiergoodall99/fluent-kit",
  "version": "1.7.1",
  "description": "Makes GitHub Copilot and other coding agents build React UI with Fluent UI v9, Fluent icons and design tokens only.",
  "license": "MIT",
  "author": "Javier Goodall",
  "type": "module",
  "bin": {
    "fluent-kit": "install.mjs"
  },
  "files": [
    "install.mjs",
    ".fluent-kit",
    "!.fluent-kit/eslint/*.test.js",
    ".github/copilot-instructions.md",
    ".github/skills",
    "README.md",
    "docs/REFERENCE.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JavierGoodall99/fluent-kit.git"
  },
  "homepage": "https://github.com/JavierGoodall99/fluent-kit#readme",
  "keywords": [
    "fluent-ui",
    "fluentui",
    "github-copilot",
    "copilot",
    "agent-skills",
    "design-system",
    "microsoft"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "check:examples": "node .fluent-kit/scripts/check.mjs .github/skills/fluent-ui/examples",
    "test:lint": "node .fluent-kit/eslint/no-hardcoded-styles.test.js && node .fluent-kit/eslint/fluent-only.test.js",
    "test:budget": "node tests/reading-cost.mjs",
    "test:links": "node tests/links.mjs",
    "test": "npm run typecheck && npm run check:examples && npm run test:lint && npm run test:budget && npm run test:links && npm run test:record && npm run test:finish && npm run test:doctor && npm run test:context && npm run test:shipped-lint",
    "test:record": "node tests/record-run.test.mjs",
    "test:shipped-lint": "eslint -c tests/eslint.shipped.config.mjs .fluent-kit install.mjs",
    "test:finish": "node tests/check-finish.test.mjs",
    "test:doctor": "node tests/doctor.test.mjs",
    "test:context": "node tests/context.test.mjs",
    "test:scaffold": "bash tests/scaffold-smoke.sh",
    "audit": "node tests/audit.mjs && node tests/reading-cost.mjs && node tests/links.mjs && node tests/render-examples.mjs",
    "test:examples": "node tests/render-examples.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fluentui-contrib/react-data-grid-react-window": "^1.4.2",
    "@fluentui/react-charts": "^9.3.29",
    "@fluentui/react-components": "^9.75.0",
    "@fluentui/react-datepicker-compat": "0.6.40",
    "@fluentui/react-icons": "^2.0.344",
    "@fluentui/react-timepicker-compat": "0.4.42",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@types/react-window": "^1.8.8",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "js-tiktoken": "^1.0.21",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-window": "^1.8.11",
    "typescript": "^6.0.3"
  }
}
